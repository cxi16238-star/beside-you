{
  "name": "her-company",
  "version": "0.13.11",
  "icon": "./icon.svg",
  "description": "dsh-see-now 的加强版：在原版「看屏幕、只传变了的帧」之上加了小窗会话绑定、自定义快捷键、焦点暂停与自动续看、静音与音量、背景透明度。· Fork of dsh-see-now with session binding, global hotkey, focus pause, volume and opacity.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "see-now",
    "screen-capture",
    "vision",
    "llm",
    "ffmpeg",
    "realtime",
    "token-efficient",
    "multimodal",
    "fork"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./pack": "./src/pack.js",
    "./png": "./src/png.js",
    "./pipeline": "./src/pipeline.js",
    "./tokens": "./src/tokens.js",
    "./capture": "./src/capture.js",
    "./chat": "./src/chat.js",
    "./speech": "./src/speech.js",
    "./voice": "./src/voice.js",
    "./interject": "./src/interject.js",
    "./window": "./src/window.js",
    "./runner": "./src/runner.js",
    "./loop": "./src/loop.js",
    "./timer": "./src/timer.js",
    "./hotkeys": "./src/hotkeys.js",
    "./companion": "./src/companion.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "bin",
    "src",
    "icon.svg",
    "locale/*.json",
    "examples/floating-chat/*.py",
    "examples/floating-chat/*.png",
    "examples/voice-say-mac.mjs",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "LICENSE",
    "NOTICE",
    "docs/images"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "verify-tokens": "node scripts/verify-image-tokens.mjs",
    "sync:window": "node scripts/sync-window.mjs",
    "check:window": "node scripts/sync-window.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "author": "SAOS-3624 (原作者) · 本 fork 由 cxi16238-star 维护",
  "contributors": [
    {
      "name": "ggfgfgf-on",
