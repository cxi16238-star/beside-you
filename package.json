    "type": "git",
    "url": "git+https://github.com/cxi16238-star/her-company.git"
  },
  "homepage": "https://github.com/cxi16238-star/her-company",
  "bugs": {
    "url": "https://github.com/cxi16238-star/her-company/issues"
  },
  "bin": {
    "dsh-see-window": "bin/see-window.mjs"
  }
}
